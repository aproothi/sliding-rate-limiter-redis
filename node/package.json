{
  "name": "@aproothi/sliding-rate-limiter-redis",
  "version": "1.0.0",
  "description": "Redis-backed sliding-window rate limiter for Node.js",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "bench": "node --loader ts-node/esm ../benchmarks/node/bench.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["rate-limiter", "redis", "sliding-window", "rate-limiting", "throttle"],
  "author": "aproothi",
  "license": "MIT",
  "peerDependencies": {
    "ioredis": ">=5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "ioredis": "^5.3.2",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
